# Firebase (obrigatório para login com Google e Firestore)
# Console: https://console.firebase.google.com/ → ⚙️ Configurações do projeto → Seus apps → SDK
# Ou na pasta do projeto: firebase login && firebase apps:list --project SEU_PROJECT_ID
#   depois: firebase apps:sdkconfig web <APP_ID> --project SEU_PROJECT_ID
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Com Firebase preenchido: login = só Google. Ative o provedor Google em Authentication → Sign-in method.
# Domínios autorizados: localhost, 127.0.0.1, seguran-39f39.web.app, seguran-39f39.firebaseapp.com

# Demo: só aparece se NÃO houver apiKey/projectId/appId do Firebase acima
VITE_DEMO_USER=demo@local
VITE_DEMO_PASS=demo123
