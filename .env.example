# Firebase (obrigatório para sync de tema e progresso do simulado)
# Obtenha em: https://console.firebase.google.com/ → Configurações do projeto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Com Firebase configurado, o login no site é SOMENTE com conta Google (Gmail).
# Ative Google em Authentication → Sign-in method. Authorized domains: localhost + seu domínio.

# Credenciais de demonstração (somente desenvolvimento SEM variáveis Firebase no .env)
# Não use em produção. Em produção, use Firebase Auth (email/senha ou outro IdP).
# Exemplo: use seu e-mail e defina uma senha; copie para .env
VITE_DEMO_USER=jjedsone@gmail.com
VITE_DEMO_PASS=sua_senha_aqui
